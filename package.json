{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo of pi (pi-coding-agent) extensions. Installable as a whole via git, or per-package via local path.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint packages",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "prepare": "husky"
  },
  "pi": {
    "extensions": [
      "packages/*/src/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "typebox": "*",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}

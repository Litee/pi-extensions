{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo of pi (pi-coding-agent) extensions. Installable as a whole via git, or per-package via local path.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "check": "npm run typecheck && npm run test"
  },
  "pi": {
    "extensions": [
      "packages/*/src/index.ts"
    ]
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.10.0",
    "typebox": "*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

{
  "name": "pi-aws-s3-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension that watches an AWS S3 object URI for existence, update, or removal, and injects state-change notifications into chat as 'pi-aws-s3-watcher' custom messages.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "pi-tools-management-tool": "^0.1.0",
    "typebox": "^1.3.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/credential-providers": "^3.1075.0",
    "pi-watcher-core": "^0.1.0"
  }
}

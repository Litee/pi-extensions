{
  "extends": [
    "@tsconfig/node22/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["packages/*/src/**/*", "packages/*/test/**/*"],
  "exclude": ["node_modules", "**/node_modules", "**/dist"]
}
